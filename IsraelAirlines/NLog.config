<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Program.cs sets this from NLogSettings:MinLevel: Debug in Development, Info elsewhere. -->
  <variable name="minLevel" value="Info" />

  <!-- HttpContext.TraceIdentifier is the correlation id set by CorrelationIdMiddleware
       (ignoreActivityId makes NLog print it instead of the W3C trace id). -->
  <variable name="lineLayout"
            value="${longdate}|${level:uppercase=true}|${aspnet-traceidentifier:ignoreActivityId=true}|${logger}|${message}${onexception:|${exception:format=tostring}}" />

  <targets>
    <target xsi:type="File"
            name="logfile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${lineLayout}" />

    <target xsi:type="Console"
            name="console"
            layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- Startup and shutdown messages from the host. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="logfile,console" final="true" />

    <!-- EF reports a rejected save (e.g. a seat conflict) as Error. Our code handles it and logs
         a Warning; real failures are logged as Error by GlobalExceptionMiddleware. -->
    <logger name="Microsoft.EntityFrameworkCore.*" maxlevel="Error" final="true" />

    <!-- Framework noise (routing, ...) only from Warning up. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="${var:minLevel}" writeTo="logfile,console" />
  </rules>
</nlog>
